# ===== 数据库（MySQL 8） =====
# DB_NAME 指定的库不存在时，后端启动会自动 CREATE DATABASE 并建表
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=ai_manga_studio2

# ===== Agnes AI（文本 / 图像 / 视频） =====
# 留空时应用仍可启动，但所有 AI 生成类任务会失败
AGNES_API_KEY=your_agnes_api_key
AGNES_BASE_URL=https://apihub.agnes-ai.com
AGNES_VIDEO_BASE_URL=https://api.agnes-ai.cn

# ===== 阿里云 DashScope TTS（留空则语音合成相关接口返回 400） =====
DASHSCOPE_API_KEY=

# ===== JWT 双令牌 =====
# JWT_SECRET 生产环境必须替换为随机串，例如: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=please_change_me_to_a_random_string
JWT_ALG=HS256
# access token 有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=15
# refresh token 有效期：勾选"记住我"用天数，否则用小时数
REFRESH_TOKEN_EXPIRE_REMEMBER_DAYS=7
REFRESH_TOKEN_EXPIRE_SESSION_HOURS=12

# ===== 登录安全策略 =====
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MINUTES=30

# ===== 找回密码验证码 =====
RESET_CODE_TTL_MINUTES=10
RESET_CODE_RESEND_SECONDS=60
RESET_CODE_MAX_ATTEMPTS=5
# 仅在本地调试时为 true：把验证码打印到服务端日志（生产环境必须保持 false）
LOG_RESET_CODE=false

# ===== 产物存储目录（相对 backend） =====
STORAGE_DIR=storage